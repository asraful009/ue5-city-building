# ========================
# Unreal Engine 5 Defaults
# ========================

# Binaries, intermediate files, caches, saved data
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Logs
*.log

# OS-specific
.DS_Store
*.swp
*.tmp
*.bak

# Visual Studio / IDE files
*.suo
*.user
*.userprefs
*.VC.db
*.VC.opendb
*.DotSettings.user

# JetBrains Rider
.idea/

# ========================
# VSCode
# ========================

# Ignore all VSCode files by default
.vscode/
.vscode/*

# Keep useful project-level VSCode settings
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Ignore generated compile commands (response files)
.vscode/compileCommands_*/

# Ignore workspace files (personal)
*.code-workspace

# ========================
# Unreal Config & Builds
# ========================

# Ignore auto-generated config backup files
Config/Windows*.ini
Config/Linux*.ini
Config/Mac*.ini

# Ignore packaged builds
*.pak
*.app
*.exe
*.dll
*.so
*.dylib

# Ignore Makefile output if generated
Makefile.*
